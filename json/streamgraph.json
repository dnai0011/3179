{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 650,
  "height": 300,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {"titleFontSize": 15, "labelFontSize": 14},
    "legend": {"labelFontSize": 13, "titleFontSize": 14}
  },
  "title": {
    "text": "Australian Recorded Music Sales by Format",
    "subtitle": "Annual Wholesale Value in AUD Millions, 1994–2023"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/aria_values.csv"
  },
  "transform": [
    {"calculate": "datum.value_thousands_aud / 1000", "as": "value_millions"},
    {
      "calculate": "datum.category === 'Vinyl' ? 'z_Vinyl' : datum.category",
      "as": "sort_order"
    },
    {
      "calculate": "'$' + format(datum.value_millions, '.1f') + 'M'",
      "as": "revenue_formatted"
    }
  ],
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": ["category"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "axis": {
        "format": "%Y",
        "tickCount": {"interval": "year", "step": 2},
        "grid": false
      },
      "title": null
    },
    "y": {
      "aggregate": "sum",
      "field": "value_millions",
      "type": "quantitative",
      "stack": "center",
      "title": "Wholesale Value",
      "axis": {
        "grid": true,
        "gridColor": "#e2e8f0",
        "gridDash": [2, 2],
        "titlePadding": 12
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "horizontal",
        "columns": 6,
        "labelFontSize": 13,
        "titleFontSize": 14,
        "labelLimit": 150
      },
      "scale": {
        "domain": [
          "Vinyl",
          "CDs",
          "Cassettes",
          "Digital Downloads",
          "Digital Other",
          "Physical Other"
        ],
        "range": [
          "#a463f2",
          "#4269d0",
          "#ff8ab7",
          "#ff725c",
          "#efb118",
          "#3ca951"
        ]
      }
    },
    "order": {"field": "sort_order", "type": "nominal", "sort": "ascending"},
    "opacity": {"condition": {"param": "hover", "value": 1}, "value": 0.15},
    "tooltip": [
      {
        "field": "year",
        "type": "temporal",
        "timeUnit": "year",
        "title": "Year"
      },
      {"field": "category", "type": "nominal", "title": "Format"},
      {"field": "revenue_formatted", "type": "nominal", "title": "Revenue"}
    ]
  }
}