{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/masters_rankings.csv"
  },
  "width": 500,
  "height": 300,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {
      "titleFontSize": 15,
      "labelFontSize": 14,
      "labelColor": "#4a5568",
      "titleColor": "#4a5568"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Most Collected Master Releases",
    "subtitle": "Top 5 Master Releases by User Collections, 2017-2020"
  },
  "transform": [
    {
      "calculate": "datum.title === \"Sgt. Pepper's Lonely Hearts Club Band\" ? \"Sgt. Pepper's\" : datum.title === \"The Dark Side of the Moon\" ? \"Dark Side of the Moon\" : datum.title",
      "as": "short_title"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "year",
          "as": "min_year"
        },
        {
          "op": "max",
          "field": "year",
          "as": "max_year"
        }
      ],
      "groupby": ["title"]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelPadding": 30,
        "domain": false,
        "ticks": false,
        "labelColor": "#4a5568",
        "labelFontSize": 14
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [5, 1]
      },
      "axis": null
    },
    "color": {
      "field": "title",
      "type": "nominal",
      "legend": null,
      "scale": {
        "scheme": "dark2"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "title"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 500
      },
      "encoding": {
        "tooltip": [
          {
            "field": "artist",
            "type": "nominal",
            "title": "Artist"
          },
          {
            "field": "title",
            "type": "nominal",
            "title": "Full Title"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 15,
        "fontWeight": "bold",
        "fill": "white"
      },
      "encoding": {
        "text": {
          "field": "rank",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2017' || datum.year === 2017"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -20,
        "font": "Inter",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#871f78"
      },
      "encoding": {
        "text": {
          "field": "short_title"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2020' || datum.year === 2020"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 16,
        "font": "Inter",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#871f78"
      },
      "encoding": {
        "text": {
          "field": "short_title"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.year === datum.min_year) && (datum.min_year > 2017 && datum.min_year < 2020)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -75,
        "font": "Inter",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#871f78"
      },
      "encoding": {
        "text": {
          "field": "short_title"
        }
      }
    }
  ]
}