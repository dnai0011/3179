
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 650,
  "height": 300,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {
      "titleFontSize": 15,
      "labelFontSize": 14,
      "domain": false
    }
  },
  "title": {
    "text": "Australia's Vinyl Revival",
    "subtitle": "Vinyl Records Sold in Thousands, 1994-2023"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/aria_units.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "color": "#a463f2",
          "filled": true,
          "size": 60
        },
        "color": "#a463f2",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "axis": {
            "title": null,
            "format": "d",
            "grid": false
          }
        },
        "y": {
          "field": "sales_units_thousands",
          "type": "quantitative",
          "axis": {
            "title": "Sales Units",
            "format": "d",
            "grid": true,
            "gridColor": "#e2e8f0",
            "gridDash": [2, 2]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2019,
            "label": "COVID-19 Pandemic"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 0,
        "fontWeight": "bold",
        "fontSize": 13,
        "color": "#7c7c7c"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "value": 5
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2019
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#7c7c7c",
