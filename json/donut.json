{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F8F4FC",
  "title": {
    "text": "Top Music Formats Collected",
    "subtitle": "Percentage Distribution of the Most Collected Formats, 2023"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/collections_format.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.format + '\\n' + datum.percentage + '%'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 85,
        "outerRadius": 150,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "percentage",
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": "format",
          "type": "nominal",
          "scale": {
            "domain": ["Vinyl", "CD", "Others"],
            "range": ["#a463f2", "#4269d0", "#31a352"]
          },
          "legend": null
        },
        "order": {
          "field": "percentage",
          "type": "quantitative",
          "sort": "descending"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 118,
        "fontSize": 14,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "color": "white",
        "align": "center"
      },
      "encoding": {
        "theta": {
          "field": "percentage",
          "type": "quantitative",
          "stack": true
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "order": {
          "field": "percentage",
          "type": "quantitative",
          "sort": "descending"
        }
      }
    }
  ],
  "view": {
    "stroke": null
  },
  "width": 450,
  "height": 350,
  "config": {
    "font": "Inter",
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    }
  }
}