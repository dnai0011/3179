{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/aria_values.csv"
  },
  "transform": [
    {"calculate": "datum.value_thousands_aud / 1000", "as": "value_millions"},
    {
      "calculate": "datum.category === 'Vinyl' ? 'z_Vinyl' : datum.category",
      "as": "sort_order"
    }
  ],
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "fields": ["category"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "axis": {"format": "%Y", "tickCount": 10},
      "title": "Year"
    },
    "y": {
      "aggregate": "sum",
      "field": "value_millions",
      "type": "quantitative",
      "stack": "center",
      "axis": null,
      "title": "Revenue (Millions AUD)"
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "legend": {"title": "Format"},
      "scale": {
        "domain": [
          "Vinyl",
          "CDs",
          "Cassettes",
          "Digital Downloads",
          "Digital Other",
          "Physical Other"
        ],
        "range": [
          "#ff725c",
          "#4269d0",
          "#ff8ab7",
          "#a463f2",
          "#efb118",
          "#3ca951"
        ]
      }
    },
    "order": {"field": "sort_order", "type": "nominal", "sort": "ascending"},
    "opacity": {"condition": {"param": "hover", "value": 1}, "value": 0.15},
    "tooltip": [
      {
        "field": "year",
        "type": "temporal",
        "timeUnit": "year",
        "title": "Year"
      },
      {"field": "category", "type": "nominal", "title": "Format"},
      {
        "field": "value_millions",
        "type": "quantitative",
        "title": "Revenue (Millions)",
        "format": "$.2f"
      }
    ]
  }
}