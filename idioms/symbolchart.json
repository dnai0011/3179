{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 800,
  "height": 300,
  "background": "#f8f5ee",
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/valuable_records.csv"
  },
  "encoding": {
    "x": {
      "field": "title",
      "type": "nominal",
      "sort": {"field": "rank", "op": "min", "order": "ascending"},
      "title": null,
      "axis": {"labels": false, "ticks": false}
    },
    "y": {"value": 150, "axis": null, "scale": {"range": [0, 300]}}
  },
  "layer": [
    {
      "mark": "circle",
      "encoding": {
        "size": {
          "field": "price",
          "type": "quantitative",
          "scale": {"range": [300, 18000]},
          "legend": null
        },
        "color": {
          "field": "genre",
          "scale": {
            "domain": ["Rock", "Funk & Soul"],
            "range": ["#d62728", "#e7ba52"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "title", "type": "nominal", "title": "Title"},
          {"field": "artist", "type": "nominal", "title": "Artist"},
          {"field": "year", "type": "quantitative", "title": "Year"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"field": "price", "type": "quantitative", "format": "$,"}
      }
    }
  ]
}