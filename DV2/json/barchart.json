{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 350,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {
      "titleFontSize": 15,
      "labelFontSize": 14,
      "labelColor": "#4a5568",
      "titleColor": "#4a5568"
    },
    "view": {
      "stroke": null
    }
  },

  "title": {
    "text": "Most Collected Music Genres",
    "subtitle": "Percentage Distribution of Genres in Discogs User Collections, 2023"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/discogs_genres.csv"
  },

  "transform": [
    {
      "calculate": "datum.genre === 'Others' ? -1 : toNumber(datum.percentage)",
      "as": "sort_value"
    },
    {
      "calculate": "toNumber(datum.percentage) + '%'",
      "as": "percentage_label"
    }
  ],

  "encoding": {
    "y": {
      "field": "genre",
      "type": "nominal",
      "sort": {
        "field": "sort_value",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelColor": "#4a5568",
        "labelFontSize": 14,
        "labelPadding": 10,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "axis": null
    },
    "color": {
      "field": "genre",
      "type": "nominal",
      "scale": {
        "domain": [
          "Rock",
          "Electronic",
          "Pop",
          "Funk & Soul",
          "Jazz",
          "Folk, World, & Country",
          "Hip-Hop",
          "Others"
        ],
        "range": [
          "#e45756",
          "#4c78a8",
          "#f781bf",
          "#b279a2",
          "#72b7b2",
          "#eeca3b",
          "#f58518",
          "#9ecae9"
        ]
      },
      "legend": null
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar"
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dx": 25,
        "dy": 8,
        "font": "Inter",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#871f78"
      },
      "encoding": {
        "text": {
          "field": "percentage_label",
          "type": "nominal"
        }
      }
    }
  ]
}