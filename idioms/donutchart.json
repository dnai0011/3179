{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/aria_physicalsales.csv"
  },
  "width": 400,
  "height": 400,
  "mark": {"type": "arc", "innerRadius": 140},
  "encoding": {
    "theta": {"field": "value", "type": "quantitative"},
    "color": {
      "field": "format",
      "type": "nominal",
      "title": "Physical Formats",
      "legend": null,
      "scale": {
        "domain": ["Singles", "Vinyl Albums", "CD Albums", "Physical Others"],
        "range": ["#ff8ab7", "#a463f2", "#4269d0", "#3ca951"]
      }
    }
  }
}