{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 300,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {
      "titleFontSize": 15,
      "labelFontSize": 14,
      "labelColor": "#4a5568",
      "titleColor": "#4a5568"
    },
    "view": {
      "stroke": null
    }
  },

  "title": {
    "text": "Most Collected Vinyl Artists of All-Time",
    "subtitle": "Top 5 Vinyl Artists based on User Collection, 2022"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/top_artists.csv"
  },

  "encoding": {
    "y": {
      "field": "artist",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelPadding": 15
      }
    },
    "x": {
      "field": "owned",
      "type": "quantitative",
      "axis": {
        "title": "Number of Records Owned",
        "titlePadding": 15,
        "format": ".2s",
        "tickCount": 10,
        "grid": true,
        "gridColor": "#e2e8f0",
        "gridDash": [2, 2],
        "domain": false
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "color": "black"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 600,
        "color": "black",
        "opacity": 1
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 160,
        "color": "#a463f2"
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -75,
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#871f78"
      },
      "encoding": {
        "text": {
          "field": "owned",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ]
}