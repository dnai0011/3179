
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 365,
  "height": 350,
  "background": "#F8F4FC",
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "#871f78",
      "fontSize": 20,
      "anchor": "start",
      "offset": 15,
      "subtitleFontSize": 14,
      "subtitleColor": "#4a5568",
      "subtitlePadding": 10
    },
    "axis": {
      "titleFontSize": 15,
      "labelFontSize": 14,
      "labelColor": "#4a5568",
      "titleColor": "#4a5568",
      "domain": true,
      "domainColor": "#a0aec0",
      "domainWidth": 1.2,
      "tickColor": "#a0aec0",
      "tickSize": 5
    }
  },

  "title": {
    "text": "Growth in Music Releases by Genre",
    "subtitle": "Number of Releases Added by Genre, 2016 vs 2019"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/genre_collections.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum['Year'])",
      "as": "year_num"
    },
    {
      "calculate": "toNumber(datum['Releases'])",
      "as": "release_count"
    },
    {
      "filter": "isValid(datum.year_num) && isValid(datum.release_count)"
    },
    {
      "calculate": "datum.year_num === 2016 ? datum.release_count : 0",
      "as": "releases_2016_row"
    },
    {
      "calculate": "datum.year_num === 2019 ? datum.release_count : 0",
      "as": "releases_2019_row"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "releases_2016_row",
          "as": "releases_2016"
        },
        {
          "op": "sum",
          "field": "releases_2019_row",
          "as": "releases_2019"
        }
      ],
      "groupby": ["Genre"]
    },
    {
      "calculate": "((datum.releases_2019 - datum.releases_2016) / datum.releases_2016) * 100",
      "as": "percentage_change"
    },
    {
      "calculate": "format(datum.percentage_change, '+.1f') + '%'",
      "as": "change_label"
    },
    {
      "calculate": "datum.Genre + ' (' + datum.change_label + ')'",
      "as": "end_label"
    },
    {
      "filter": "datum.year_num === 2016 || datum.year_num === 2019"
    }
  ],

  "encoding": {
    "x": {
      "field": "year_num",
      "type": "quantitative",
      "scale": {
        "domain": [2015.5, 2019],
        "nice": false
      },
      "axis": {
        "title": null,
        "values": [2016, 2019],
        "format": "d",
        "grid": false,
        "ticks": true,
        "domain": true,
        "domainColor": "#4a5568",
        "domainWidth": 1.2,
        "tickColor": "#4a5568",
        "labelPadding": 10
      }
    },

    "y": {
      "field": "release_count",
      "type": "quantitative",
      "scale": {
        "zero": false
      },
      "axis": {
        "title": "Number of Releases",
        "format": "~s",
        "grid": true,
        "gridColor": "#e2e8f0",
        "gridDash": [2, 2],
        "gridWidth": 1,
        "tickCount": 5,
        "domain": true,
        "domainColor": "#4a5568",
        "domainWidth": 1.2,
        "tickColor": "#4a5568",
        "labelPadding": 8,
        "titlePadding": 15
      }
    },

    "color": {
      "field": "Genre",
      "type": "nominal",
      "scale": {
        "domain": [
          "Rock",
          "Electronic",
          "Pop",
          "Funk & Soul",
          "Jazz",
          "Folk, World, & Country",
          "Hip-Hop"
        ],
        "range": [
          "#e45756",
          "#4c78a8",
          "#f781bf",
          "#b279a2",
          "#72b7b2",
          "#eeca3b",
          "#f58518"
        ]
      },
      "legend": null
    }
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 75
        }
      },
      "encoding": {
        "detail": {
          "field": "Genre"
        },
        "order": {
          "field": "year_num",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_num === 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "end_label",
          "type": "nominal"
        }
      }
    }
  ]
}