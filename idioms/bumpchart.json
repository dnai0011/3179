{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/dnai0011/3179/refs/heads/main/data/masters_rankings.csv"
  },
  "width": 650,
  "height": 350,
  "background": "#f8f5ee",
  "encoding": {
    "x": {
      "field": "year",
      "type": "nominal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelPadding": 30,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {"domain": [5, 1]},
      "axis": null
    },
    "color": {
      "field": "title",
      "type": "nominal",
      "legend": null,
      "scale": {"scheme": "dark2"}
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {"op": "min", "field": "year", "as": "min_year"},
        {"op": "max", "field": "year", "as": "max_year"}
      ],
      "groupby": ["title"]
    }
  ],
  "layer": [
    {
      "mark": {"type": "line", "interpolate": "monotone", "strokeWidth": 3},
      "encoding": {"detail": {"field": "title"}}
    },
    {
      "mark": {"type": "circle", "size": 500},
      "encoding": {
        "tooltip": [
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {"field": "artist", "type": "nominal", "title": "Artist"},
          {"field": "title", "type": "nominal", "title": "Album"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "fill": "white"
      },
      "encoding": {"text": {"field": "rank", "type": "quantitative"}}
    },
    {
      "transform": [{"filter": "datum.year === '2017' || datum.year === 2017"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -20,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {"text": {"field": "title"}}
    },
    {
      "transform": [{"filter": "datum.year === '2020' || datum.year === 2020"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 16,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {"text": {"field": "title"}}
    },
    {
      "transform": [
        {
          "filter": "(datum.year === datum.min_year) && (datum.min_year > 2017 && datum.min_year < 2020)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -65,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {"text": {"field": "title"}}
    }
  ]
}